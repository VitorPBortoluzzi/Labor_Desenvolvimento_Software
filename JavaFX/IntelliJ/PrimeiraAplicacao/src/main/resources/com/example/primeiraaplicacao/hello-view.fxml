<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="303.0" prefWidth="335.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.primeiraaplicacao.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Campo para digitar o nome-->
    <TextField fx:id="txtF_nome" prefHeight="25.0" prefWidth="148.0" promptText="Digite seu nome" />
    <TextField fx:id="txtF_sobrenome" promptText="Digite seu sobrenome" />
   <HBox alignment="CENTER" prefHeight="38.0" prefWidth="121.0">
      <children>
            <!-- Botao que chama o metodo do controller-->
            <Button mnemonicParsing="false" onAction="#limparCampos" text="Limpar" textAlignment="CENTER" />

            <!-- Botao que chama o metodo do controller-->
            <Button mnemonicParsing="false" onAction="#exibirMensagem" text="Enviar" />
      </children>
   </HBox>

          <!-- Campo para digitar o nome-->
    <Label fx:id="lbl_mensagem" alignment="CENTER" prefHeight="17.0" prefWidth="95.0" textAlignment="CENTER" />
    <Button onAction="#onHelloButtonClick" text="Hello!" />

    <Label fx:id="welcomeText" prefHeight="17.0" prefWidth="100.0" textOverrun="CLIP" wrapText="true" />
</VBox>
