<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="460" prefWidth="780" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projetobanco.controller.PessoaController">

    <top>
        <ToolBar>
            <Button onAction="#onNovo" text="Novo" />
            <Button onAction="#onSalvar" text="Salvar" />
            <Button onAction="#onExcluir" text="Excluir" />
        </ToolBar>
    </top>

    <center>
        <TableView fx:id="table" prefHeight="300">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="280" text="Nome" />
                <TableColumn fx:id="colSexo" prefWidth="80" text="Sexo" />
                <TableColumn fx:id="colIdioma" prefWidth="160" text="Idioma" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <GridPane hgap="10" vgap="10">
            <padding><Insets topRightBottomLeft="10" /></padding>

            <columnConstraints>
                <ColumnConstraints percentWidth="15" />
                <ColumnConstraints percentWidth="35" />
                <ColumnConstraints percentWidth="15" />
                <ColumnConstraints percentWidth="35" />
            </columnConstraints>

            <!-- Linha 1 -->
            <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtId" editable="false" prefHeight="25.0" prefWidth="53.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nome:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtNome" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <!-- Linha 2 -->
            <Label text="Sexo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="cbSexo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Idioma:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <ComboBox fx:id="cbIdioma" GridPane.columnIndex="3" GridPane.rowIndex="1" />
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </bottom>
</BorderPane>
